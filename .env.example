# Template: copy to .env (git-ignored) and fill in your own values. Never commit .env.
# deploy/compose.yml reads ../.env by default.
# SMTP: for Gmail use smtp.gmail.com, port 587 and an App Password (not your normal password).
IAM_DATABASE_URL=jdbc:postgresql://dlc-postgres:5432/di_lucca
IAM_DATABASE_USER=iam_runtime
IAM_DATABASE_PASSWORD=
IAM_JWT_PRIVATE_KEY_PEM=
IAM_JWT_PUBLIC_KEY_PEM=
IAM_JWT_KID=
IAM_JWT_ISSUER=
IAM_JWT_AUDIENCE=
IAM_INTERNAL_SERVICE_JWKS_URI=
IAM_INTERNAL_SERVICE_ISSUER=
IAM_INTERNAL_SERVICE_AUDIENCE=
IAM_REGISTRATION_PROOF_KEY_BASE64=
IAM_AUTH_ALLOWED_ORIGIN=
IAM_LOGIN_IP_DIGEST_KEY_BASE64=
IAM_TRUSTED_GATEWAY_IP=
IAM_CSRF_KEY_BASE64=
IAM_EMAIL_SMTP_HOST=
IAM_EMAIL_SMTP_PORT=587
# true=STARTTLS (port 587, default). Set both to false and IAM_EMAIL_SMTP_SSL=true for implicit SSL (port 465).
IAM_EMAIL_SMTP_STARTTLS=true
IAM_EMAIL_SMTP_SSL=false
IAM_EMAIL_SMTP_CONNECT_TIMEOUT_MS=10000
IAM_EMAIL_SMTP_TIMEOUT_MS=10000
IAM_EMAIL_SMTP_USER=
IAM_EMAIL_SMTP_PASSWORD=
IAM_EMAIL_FROM=
IAM_IDENTITY_EMAIL_LIMIT_KEY_BASE64=
# Optional public-only JWK objects for verification during key rollover.
IAM_JWT_PREVIOUS_JWKS_JSON=[]
IAM_RABBITMQ_HOST=
IAM_RABBITMQ_PORT=5672
IAM_RABBITMQ_USER=
IAM_RABBITMQ_PASSWORD=
IAM_OUTBOX_EXCHANGE=iam.events.v1
